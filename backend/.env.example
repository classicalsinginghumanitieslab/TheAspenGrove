NEO4J_URI=neo4j+s://<your-neo4j-host>
NEO4J_USER=<neo4j-username>
NEO4J_PASSWORD=<neo4j-password>
NEO4J_ENCRYPTION=off

# Prefer a public proxy host/port provided by your platform (Railway)
MYSQL_HOST=<mysql-host>
MYSQL_PORT=<mysql-port>
MYSQL_USER=<mysql-user>
MYSQL_PASSWORD=<mysql-password>
MYSQL_DATABASE=<mysql-db>
MYSQL_SSL=true

# Alternatively, use a single connection URL (overrides the above when set)
# MYSQL_URL=mysql://user:pass@host:port/dbname

# JWT secret used to sign auth tokens
JWT_SECRET=<a-long-random-secret>

# Allowed client origins (comma-separated). Example: https://yourdomain.com,https://preview.yourdomain.com
CLIENT_ORIGINS=https://yourdomain.com

# Optional email reset configuration (enable if you plan to send reset emails)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
RESET_URL_BASE=

# Optional: tune internal caches/limits
# PATH_CACHE_TTL_MS=600000
# MYSQL_CONNECTION_LIMIT=10
# MAX_SNAPSHOT_BYTES=1500000
